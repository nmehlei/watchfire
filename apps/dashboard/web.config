<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows App Service (iisnode) entry for the Next.js standalone server.
  The standard iisnode configuration for a Next.js standalone server.
  The named-pipe PORT is handled by the server.js wrapper (which
  iisnode launches); requests for real files are served directly by IIS,
  everything else is rewritten to the Node server.
-->
<configuration>
  <system.webServer>
    <handlers>
      <remove name="iisnode" />
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="DynamicContent" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>
    <iisnode node_env="production"
             loggingEnabled="true"
             logDirectory="iisnode"
             devErrorsEnabled="false"
             debuggingEnabled="false"
             watchedFiles="web.config;*.js" />
    <!-- OAuth/Entra authorization codes routinely push the callback URL
         past IIS's default maxQueryString=2048, which silently returns
         404 before iisnode is invoked. Raise to the IIS maximum for the
         URL (32767, just under the 32768 hard cap) and 64KB for the
         query string (well under the 2 MB cap) to accommodate long auth
         codes + state + nonce. -->
    <security>
      <requestFiltering>
        <requestLimits maxUrl="32767" maxQueryString="65536" />
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
