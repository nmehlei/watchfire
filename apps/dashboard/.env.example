# Local development overrides. Copy to .env.local and fill in real values.
# In production, set these as application settings on the host — never commit
# real values.

# Watchfire backend (server-side only; never reaches the browser)
WATCHFIRE_API_URL=https://watchfire.example.com
WATCHFIRE_API_TOKEN=replace_with_real_bearer

# Auth.js session encryption — generate fresh with `openssl rand -base64 32`
AUTH_SECRET=replace_with_random_32_bytes_base64

# Auth.js — Microsoft Entra provider. Values come from your Entra ID app
# registration (client id, client secret, and your tenant id in the issuer).
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_TRUST_HOST=true
